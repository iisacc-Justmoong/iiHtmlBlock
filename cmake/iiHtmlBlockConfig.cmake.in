@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

function(_iiHtmlBlock_detect_target_platform out_var)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(${out_var} "ios" PARENT_SCOPE)
        set(_iiHtmlBlockTargetQtPrefix "$ENV{HOME}/Qt/6.8.3/ios" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(${out_var} "android" PARENT_SCOPE)
        set(_iiHtmlBlockTargetQtPrefix "$ENV{HOME}/Qt/6.8.3/android_arm64_v8a" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
        set(${out_var} "wasm" PARENT_SCOPE)
        set(_iiHtmlBlockTargetQtPrefix "$ENV{HOME}/Qt/6.8.3/wasm_multithread" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(${out_var} "macos" PARENT_SCOPE)
        set(_iiHtmlBlockTargetQtPrefix "$ENV{HOME}/Qt/6.8.3/macos" PARENT_SCOPE)
    else()
        set(${out_var} "" PARENT_SCOPE)
        set(_iiHtmlBlockTargetQtPrefix "" PARENT_SCOPE)
    endif()
endfunction()

_iiHtmlBlock_detect_target_platform(_iiHtmlBlockTargetPlatform)

get_filename_component(_iiHtmlBlockCurrentPrefixName "${PACKAGE_PREFIX_DIR}" NAME)
get_filename_component(_iiHtmlBlockCurrentPrefixParent "${PACKAGE_PREFIX_DIR}" DIRECTORY)
get_filename_component(_iiHtmlBlockCurrentPrefixParentName "${_iiHtmlBlockCurrentPrefixParent}" NAME)
set(_iiHtmlBlockInPlatformPrefix FALSE)
if(_iiHtmlBlockCurrentPrefixParentName STREQUAL "platforms")
    set(_iiHtmlBlockInPlatformPrefix TRUE)
endif()

if(NOT _iiHtmlBlockTargetPlatform STREQUAL ""
        AND NOT (_iiHtmlBlockInPlatformPrefix
            AND _iiHtmlBlockCurrentPrefixName STREQUAL _iiHtmlBlockTargetPlatform))
    if(_iiHtmlBlockInPlatformPrefix)
        set(_iiHtmlBlockPlatformConfig
            "${_iiHtmlBlockCurrentPrefixParent}/${_iiHtmlBlockTargetPlatform}/lib/cmake/iiHtmlBlock/iiHtmlBlockConfig.cmake")
    else()
        set(_iiHtmlBlockPlatformConfig
            "${PACKAGE_PREFIX_DIR}/platforms/${_iiHtmlBlockTargetPlatform}/lib/cmake/iiHtmlBlock/iiHtmlBlockConfig.cmake")
    endif()
    if(EXISTS "${_iiHtmlBlockPlatformConfig}")
        include("${_iiHtmlBlockPlatformConfig}")
        return()
    elseif(NOT _iiHtmlBlockTargetPlatform STREQUAL "")
        message(FATAL_ERROR
            "iiHtmlBlock ${_iiHtmlBlockTargetPlatform} package was not found at "
            "${_iiHtmlBlockPlatformConfig}. Run iiHtmlBlock install.sh so it "
            "installs the matching platform package.")
    endif()
endif()

get_filename_component(_iiHtmlBlockSiblingIiXmlPrefix "${PACKAGE_PREFIX_DIR}/../iiXml" ABSOLUTE)

set(_iiHtmlBlockDependencyPrefixes)
if(NOT _iiHtmlBlockTargetPlatform STREQUAL "")
    get_filename_component(_iiHtmlBlockPlatformSiblingIiXmlPrefix
        "${PACKAGE_PREFIX_DIR}/../../../iiXml/platforms/${_iiHtmlBlockTargetPlatform}"
        ABSOLUTE)
    list(APPEND _iiHtmlBlockDependencyPrefixes
        "${_iiHtmlBlockTargetQtPrefix}"
        "${_iiHtmlBlockPlatformSiblingIiXmlPrefix}"
        "$ENV{HOME}/.local/iiXml/platforms/${_iiHtmlBlockTargetPlatform}")
endif()

if(NOT _iiHtmlBlockTargetPlatform STREQUAL "")
    foreach(_iiHtmlBlockPlatformDependencyPrefix IN LISTS _iiHtmlBlockDependencyPrefixes)
        set(_iiHtmlBlockPlatformIiXmlDir
            "${_iiHtmlBlockPlatformDependencyPrefix}/lib/cmake/iiXml")
        if(EXISTS "${_iiHtmlBlockPlatformIiXmlDir}/iiXmlConfig.cmake")
            set(iiXml_DIR "${_iiHtmlBlockPlatformIiXmlDir}" CACHE PATH
                "iiXml package directory for iiHtmlBlock ${_iiHtmlBlockTargetPlatform}" FORCE)
            break()
        endif()
    endforeach()
endif()

list(APPEND _iiHtmlBlockDependencyPrefixes
    "${_iiHtmlBlockSiblingIiXmlPrefix}"
    "$ENV{HOME}/.local/iiXml"
    "$ENV{HOME}/Qt/6.8.3/macos")

list(REVERSE _iiHtmlBlockDependencyPrefixes)
foreach(_iiHtmlBlockDependencyPrefix IN LISTS _iiHtmlBlockDependencyPrefixes)
    if(EXISTS "${_iiHtmlBlockDependencyPrefix}")
        list(PREPEND CMAKE_PREFIX_PATH "${_iiHtmlBlockDependencyPrefix}")
    endif()
endforeach()

unset(_iiHtmlBlockDependencyPrefix)
unset(_iiHtmlBlockDependencyPrefixes)
unset(_iiHtmlBlockPlatformIiXmlDir)
unset(_iiHtmlBlockPlatformDependencyPrefix)
unset(_iiHtmlBlockPlatformSiblingIiXmlPrefix)
unset(_iiHtmlBlockSiblingIiXmlPrefix)
unset(_iiHtmlBlockPlatformConfig)
unset(_iiHtmlBlockInPlatformPrefix)
unset(_iiHtmlBlockCurrentPrefixParentName)
unset(_iiHtmlBlockCurrentPrefixParent)
unset(_iiHtmlBlockCurrentPrefixName)
unset(_iiHtmlBlockTargetPlatform)
unset(_iiHtmlBlockTargetQtPrefix)

find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
find_dependency(iiXml 0.1.0 CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/iiHtmlBlockTargets.cmake")
